{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "console": "integratedTerminal",
      "name": "DEVELOPMENT (DOCKER)",
      "runtimeExecutable": "npm",
      "preLaunchTask": "Start Docker Postgres",
      "postDebugTask": "Destroy Docker Postgres",
      "runtimeArgs": ["run", "start:dev"],
      "env": {
        "DATABASE_URL": "postgresql://postgres:mysecretpassword@localhost:6000/dockerdatabase?schema=test",
        "NODE_ENV": "development",
        "PORT": "3000"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "console": "integratedTerminal",
      "name": "prod integratedTerminal",
      "runtimeExecutable": "npm",
      "preLaunchTask": "npm: build",
      "runtimeArgs": ["run", "start:prod"]
    },
    {
      "type": "node",
      "request": "launch",
      "console": "integratedTerminal",
      "name": "DEVELOPMENT integratedTerminal",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"]
    }
  ]
}
